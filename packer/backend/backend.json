{
  "variables": {
    "aws_region": "us-east-1",
    "source_ami": "",
    "instance_type": "t3.micro",
    "ssh_username": "ec2-user",
    "vpc_id": "",
    "subnet_id": "",
    "security_group_id": ""
  },

  "builders": [
    {
      "type": "amazon-ebs",
      "region": "{{user `aws_region`}}",
      "source_ami": "{{user `source_ami`}}",
      "instance_type": "{{user `instance_type`}}",
      "ssh_username": "{{user `ssh_username`}}",
      "vpc_id": "{{user `vpc_id`}}",
      "subnet_id": "{{user `subnet_id`}}",
      "security_group_id": "{{user `security_group_id`}}",

      "associate_public_ip_address": true,
      "temporary_key_pair_name": "packer-{{timestamp}}",
      "ssh_interface": "public_ip",
      "ssh_timeout": "10m",
      "ssh_handshake_attempts": 30,
      "communicator": "ssh",
      "ssh_pty": true,

      "ami_name": "three-tier-backend-{{timestamp}}",
      "ami_description": "Backend AMI with Apache, PHP and application",

      "tags": {
        "Name": "three-tier-backend",
        "Environment": "dev",
        "Component": "backend"
      }
    }
  ],

  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo dnf update -y",
        "sudo dnf install -y httpd php php-fpm php-mysqli php-json php-mbstring php-cli git unzip",
        "sudo systemctl enable httpd",
        "sudo usermod -a -G apache ec2-user"
      ]
    },

    {
      "type": "shell",
      "inline": [
        "curl -sS https://getcomposer.org/installer -o /tmp/composer-setup.php",
        "sudo php /tmp/composer-setup.php --install-dir=/usr/local/bin --filename=composer",
        "composer --version"
      ]
    },

    {
      "type": "shell",
      "inline": [
        "sudo mkdir -p /var/www/html/api",
        "sudo chown -R ec2-user:apache /var/www/html"
      ]
    },

    {
      "type": "shell",
      "inline": [
        "cd /tmp",
        "git clone https://github.com/meetbrij/3tier-app-code.git",
        "cd 3tier-app-code",
        "composer install --no-dev --optimize-autoloader"
      ]
    },

    {
      "type": "shell",
      "inline": [
        "sudo cp -r /tmp/3tier-app-code/backend/api/* /var/www/html/api/",
        "sudo cp -r /tmp/3tier-app-code/vendor /var/www/html/vendor",
        "sudo chown -R apache:apache /var/www/html",
        "sudo find /var/www/html -type d -exec chmod 755 {} \\;",
        "sudo find /var/www/html -type f -exec chmod 644 {} \\;"
      ]
    },

    {
      "type": "shell",
      "inline": [
        "sudo rm -rf /tmp/3tier-app-code",
        "sudo rm -f /tmp/composer-setup.php"
      ]
    }
  ],

  "post-processors": [
    {
      "type": "manifest",
      "output": "manifest.json"
    }
  ]
}