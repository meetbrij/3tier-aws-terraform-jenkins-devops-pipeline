aws_region          = "us-east-1"
environment         = "dev"
project_name        = "three-tier-app"

db_instance_class   = "db.t3.micro"
db_engine           = "mysql"
db_engine_version   = "8.0"
db_name             = "appdb"
db_username         = "admin"
db_allocated_storage = 20
db_storage_type     = "gp3"

terraform_state_bucket = "3tier-aws-terraform-jenkins-devops-pipeline"